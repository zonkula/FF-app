{
  "rules": {
    ".read": false,
    ".write": false,

    "drafts": {
      "$weekId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "leagueHistory": {
      "$weekId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "playersCache": {
      "$season": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}

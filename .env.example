# Firebase project config (Project Settings > General > Your apps > Web app, in the Firebase console)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Gate for /admin. Client-side check only (baked into the JS bundle, like any VITE_ var) - this
# keeps casual visitors out, it is not real access control. Leave blank to disable admin login entirely.
VITE_ADMIN_PASSWORD=

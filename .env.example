# Firebase project config (Project Settings > General > Your apps > Web app, in the Firebase console)
VITE_FIREBASE_API_KEY=***REDACTED-API-KEY***
VITE_FIREBASE_AUTH_DOMAIN=ff-weekly-draft.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://ff-weekly-draft-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=ff-weekly-draft
VITE_FIREBASE_STORAGE_BUCKET=ff-weekly-draft.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=451998241709
VITE_FIREBASE_APP_ID=1:451998241709:web:f3faf2e9fa3e9597268724

# Gate for /admin. Client-side check only (baked into the JS bundle, like any VITE_ var) - this
# keeps casual visitors out, it is not real access control. Leave blank to disable admin login entirely.
VITE_ADMIN_PASSWORD=***REDACTED-PASSWORD***
